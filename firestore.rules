rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // YARDIMCI FONKSİYONLAR
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Sistem admini tek kaynaktan okunur: users/{uid}.is_admin === true
    // exists() kontrolü, kullanıcı belgesi henüz oluşmamışken kuralın
    // hata vermesini engeller.
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().get('is_admin', false) == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Güncellemede yalnızca izin verilen alanların değişmesini sağlar.
    function changedKeysOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Etkinliği oluşturan kişi (kulüp yöneticisi) kontrolü.
    function isEventOwner(eventId) {
      return isSignedIn()
        && eventId != ''
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId))
             .data.get('olusturan_id', '') == request.auth.uid;
    }

    // Üye yalnızca kendi katılım kaydını ekleyip çıkarabilir.
    // (Katıl / ayrıl işlemleri events.katilimcilar dizisini günceller.)
    function isSelfParticipationChange() {
      let before = resource.data.get('katilimcilar', []);
      let after = request.resource.data.get('katilimcilar', []);
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());

      return changedKeysOnly(['katilimcilar'])
        && (
          (added.hasOnly([request.auth.uid]) && added.size() == 1 && removed.size() == 0)
          || (removed.hasOnly([request.auth.uid]) && removed.size() == 1 && added.size() == 0)
        );
    }

    // Davet kabulünde üyeliğin gerçek bir davete dayandığını doğrular.
    // Üyelik belgesindeki davet_token, invitations/{token} belgesiyle eşleşmeli.
    function hasValidInvitation(clubId, role) {
      let token = request.resource.data.get('davet_token', '');
      let targetEmail = get(/databases/$(database)/documents/users/$(request.resource.data.user_id))
                           .data.get('email', '');

      return token != ''
        && exists(/databases/$(database)/documents/invitations/$(token))
        && get(/databases/$(database)/documents/invitations/$(token))
             .data.get('club_id', '') == clubId
        && get(/databases/$(database)/documents/invitations/$(token))
             .data.get('role', '') == role
        && get(/databases/$(database)/documents/invitations/$(token))
             .data.get('email', '') == targetEmail;
    }

    // =========================================================
    // KULLANICILAR
    // =========================================================

    match /users/{userId} {
      // Profil listeleri, üye listeleri, yoklama isimleri için gerekli.
      allow read: if isSignedIn();

      // Kayıt olan / davet kabul eden kullanıcı yalnızca KENDİ belgesini
      // oluşturabilir ve asla admin olarak oluşturamaz.
      allow create: if isOwner(userId)
        && request.resource.data.get('is_admin', false) == false;

      // Kullanıcı kendi profilini ve push token'ını güncelleyebilir ama
      // is_admin alanını değiştiremez. Admin herkesi güncelleyebilir.
      allow update: if isSuperAdmin()
        || (isOwner(userId)
            && request.resource.data.get('is_admin', false)
               == resource.data.get('is_admin', false));

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // KULÜPLER
    // =========================================================

    match /clubs/{clubId} {
      allow read: if true;

      // Kulüp oluşturma/silme yalnızca sistem admini.
      allow create, delete: if isSuperAdmin();

      // Kulüp bilgileri yalnızca tanımlı alanlar üzerinden güncellenebilir.
      // Aktif/pasif durumu yalnızca sistem admini değiştirebilir.
      // Not: Firestore kuralları koleksiyon sorgusu yapamadığı için "bu kulübün
      // yöneticisi mi?" kontrolü burada yapılamıyor. Yönetici kontrolü istemci
      // tarafında yapılıyor; ileride club_managers koleksiyonu ile sıkılaştırılmalı.
      allow update: if isSuperAdmin()
        || (isSignedIn()
            && changedKeysOnly(['ad', 'aciklama', 'detayliAciklama', 'gorselUrl']));
    }

    // =========================================================
    // KATILIM TALEPLERİ
    // =========================================================

    match /join_requests/{requestId} {
      // Yönetici kendi kulübünün başvurularını, üye kendi başvurusunu okur.
      allow read: if isSignedIn();

      // Kullanıcı yalnızca kendi adına ve "beklemede" durumunda başvuru açar.
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.club_id is string
        && request.resource.data.durum == 'beklemede';

      // Onay/red yalnızca durum alanlarını değiştirebilir.
      // Başvuru sahibi kendi talebini onaylayamaz/reddedemez.
      allow update: if isSignedIn()
        && request.auth.uid != resource.data.get('user_id', '')
        && changedKeysOnly(['durum', 'updatedAt', 'karar_tarihi'])
        && request.resource.data.durum in ['onaylandi', 'reddedildi'];

      // Talep kayıtları normalde silinmez; kulüp silme temizliği admin'e açıktır.
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // ÜYELİKLER
    // =========================================================

    match /memberships/{membershipId} {
      allow read: if isSignedIn();

      // Başvuru, davet kabulü, yönetici onayı ve doğrudan ekleme bu yolu kullanır.
      // Kullanıcı kendisi için yalnızca "beklemede/üye" kaydı açabilir; kendini
      // doğrudan aktif üye veya yönetici yapamaz. Aktif kayıt için ya geçerli bir
      // davet ya da başka bir kullanıcı (yönetici/admin) adına işlem gerekir.
      allow create: if isSignedIn()
        && request.resource.data.club_id is string
        && request.resource.data.user_id is string
        && request.resource.data.role in ['uye', 'yonetici']
        && request.resource.data.status in ['beklemede', 'aktif', 'pasif', 'reddedildi']
        && (
          (request.resource.data.user_id == request.auth.uid
            && request.resource.data.status == 'beklemede'
            && request.resource.data.role == 'uye')
          || request.resource.data.user_id != request.auth.uid
          || hasValidInvitation(
               request.resource.data.club_id,
               request.resource.data.role
             )
        );

      // Rol/durum dışındaki alanlar (club_id, user_id) değiştirilemez.
      // Kullanıcı kendi üyeliğini yalnızca yeniden başvuru için
      // "beklemede/üye" durumuna çekebilir; kendini onaylayamaz veya
      // kendine yönetici rolü veremez.
      allow update: if isSignedIn()
        && changedKeysOnly(['role', 'status', 'katilim_tarihi'])
        && (
          resource.data.get('user_id', '') != request.auth.uid
          || (request.resource.data.status == 'beklemede'
              && request.resource.data.role == 'uye')
        );

      // Üye çıkarma ve onay sırasındaki mükerrer temizliği için gerekli.
      allow delete: if isSignedIn();
    }

    // =========================================================
    // DAVETLER
    // =========================================================

    match /invitations/{inviteId} {
      // Davet belgesinin kimliği token'ın kendisidir. Giriş yapmadan yalnızca
      // TAM token ile tek belge okunabilir; listelemek için oturum gerekir.
      allow get: if true;
      allow list: if isSignedIn();

      // Davet oluşturma yönetici panelinden yapılır; kimlik = token kuralı.
      // Kişinin kendi e-postasına davet üretmesi engellenir (kendini kulübe
      // yönetici olarak ekleme girişimini zorlaştırır).
      allow create: if isSignedIn()
        && inviteId == request.resource.data.token
        && request.resource.data.club_id is string
        && request.resource.data.email is string
        && request.resource.data.role in ['uye', 'yonetici']
        && request.resource.data.email.lower() != currentUser().get('email', '').lower();

      // Yenileme eski belgeyi silip yeni token ile belge oluşturur.
      allow update: if false;

      // Davet kabulü (yeni kullanıcı oturumu) ve yönetici iptali.
      allow delete: if isSignedIn();
    }

    // =========================================================
    // DUYURULAR
    // =========================================================

    match /announcements/{announcementId} {
      allow read: if isSignedIn();

      // Sistem duyurusu yalnızca admin; kulüp duyurusu kulüp adına ve
      // yayınlayanın kendi kimliğiyle oluşturulabilir.
      allow create: if isSignedIn()
        && request.resource.data.yayinlayan_id == request.auth.uid
        && (
          (request.resource.data.kapsam == 'sistem'
            && request.resource.data.club_id == null
            && isSuperAdmin())
          || (request.resource.data.kapsam == 'kulup'
            && request.resource.data.club_id is string)
        );

      // Yalnızca içerik alanları güncellenebilir.
      allow update: if isSuperAdmin()
        || (isSignedIn()
            && resource.data.get('yayinlayan_id', '') == request.auth.uid
            && changedKeysOnly(['baslik', 'icerik', 'updatedAt']));

      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.get('yayinlayan_id', '') == request.auth.uid);
    }

    // =========================================================
    // ETKİNLİKLER
    // =========================================================

    match /events/{eventId} {
      allow read: if isSignedIn();

      // Kulüp etkinliğini oluşturan kişi kendi kimliğini yazmak zorundadır.
      // Sistem geneli etkinlik (club_id yok) yalnızca admin tarafından açılır.
      allow create: if isSignedIn()
        && request.resource.data.olusturan_id == request.auth.uid
        && (
          (request.resource.data.club_id == null && isSuperAdmin())
          || request.resource.data.club_id is string
        );

      // Admin her etkinliği; yönetici yalnızca kendi oluşturduğu etkinliği
      // düzenleyebilir. Üyeler yalnızca kendi katılım durumlarını değiştirebilir.
      allow update: if isSuperAdmin()
        || (isSignedIn()
            && resource.data.get('olusturan_id', '') == request.auth.uid
            && changedKeysOnly([
              'baslik', 'aciklama', 'konum', 'tarih', 'kontenjan',
              'gorselUrl', 'hedef_kitle', 'status', 'katilimcilar'
            ]))
        || isSelfParticipationChange();

      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.get('olusturan_id', '') == request.auth.uid);
    }

    // =========================================================
    // ETKİNLİK BAŞVURULARI (eski şema - kullanılmıyor)
    // =========================================================

    match /event_applications/{appId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // =========================================================
    // BİLDİRİMLER (uygulama içi bildirim geçmişi)
    // =========================================================

    match /notifications/{notificationId} {
      // Kullanıcı yalnızca kendi bildirimlerini okuyabilir.
      allow read: if isSignedIn()
        && resource.data.get('user_id', '') == request.auth.uid;

      // Bildirim kaydı, duyuru/etkinlik/başvuru tetikleyicisi tarafından
      // hedef kullanıcılar adına oluşturulur.
      allow create: if isSignedIn()
        && request.resource.data.user_id is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.read == false;

      // Yalnızca okundu bilgisi değiştirilebilir.
      allow update: if isSignedIn()
        && resource.data.get('user_id', '') == request.auth.uid
        && changedKeysOnly(['read']);

      allow delete: if false;
    }

    // =========================================================
    // YOKLAMA
    // =========================================================

    match /attendance/{attendanceId} {
      // Admin tüm yoklamaları, üye kendi yoklamasını, etkinlik sahibi
      // yönetici kendi etkinliğinin yoklamasını görebilir.
      allow read: if isSignedIn()
        && (
          isSuperAdmin()
          || resource.data.get('user_id', '') == request.auth.uid
          || (resource.data.get('event_id', '') != ''
            && isEventOwner(resource.data.get('event_id', '')))
        );

      // Yoklama, işlemi yapan kişi adına ve yalnızca admin veya etkinlik
      // sahibi yönetici tarafından alınabilir.
      allow create: if isSignedIn()
        && request.resource.data.alan_yonetici_id == request.auth.uid
        && (isSuperAdmin() || isEventOwner(request.resource.data.get('event_id', '')));

      // Yoklama kaydı değiştirilemez; yalnızca kulüp silme temizliğinde admin siler.
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // TANIMSIZ TÜM YOLLAR KAPALI
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
