{
  "expo": {
    "name": "Kulüp Yönetim Sistemi",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.buseguvez.kulupyonetimsistemimobil",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4aa2263e-5e36-4dca-a382-2d8c9da28f5e"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafınızı seçebilmek için galeri erişimine ihtiyacımız var."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Etkinlik yoklaması için üyelerin QR kodlarını okutmak üzere kamera erişimine ihtiyacımız var.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4aa2263e-5e36-4dca-a382-2d8c9da28f5e"
    }
  }
}
